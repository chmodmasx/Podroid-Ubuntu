#!/bin/sh
# Podroid initramfs bootstrap.
# Mount the persistent overlay and switch_root into the guest rootfs.
set -e

# Ensure mount points exist. cpio packing can omit empty directories.
mkdir -p /proc /sys /dev /run

echo "[podroid-init] mounting virtual filesystems" > /dev/console

# Keep options before positional arguments for util-linux mount.
mount -t proc  -o noexec,nosuid,nodev proc  /proc
echo "[podroid-init] mounted /proc" > /dev/console
mount -t sysfs -o noexec,nosuid,nodev sysfs /sys
echo "[podroid-init] mounted /sys" > /dev/console

# CONFIG_DEVTMPFS_MOUNT may already provide /dev.
mount -t devtmpfs -o exec,nosuid,mode=0755 devtmpfs /dev || true
echo "[podroid-init] mounted /dev (or reused kernel pre-mount)" > /dev/console

# Ubuntu uses systemd as PID 1. Give it a real volatile /run.
mount -t tmpfs -o rw,nosuid,nodev,mode=0755 tmpfs /run

# systemd and the container engines expect a unified cgroup v2 mount.
mkdir -p /sys/fs/cgroup
mountpoint -q /sys/fs/cgroup || mount -t cgroup2 cgroup2 /sys/fs/cgroup

echo "Mounting storage..." > /dev/console

# virtio_blk is built-in; modprobe remains a no-op safety net.
[ -d "/lib/modules/$(uname -r)" ] && { depmod -a 2>/dev/null; modprobe virtio_blk 2>/dev/null; }

# /dev/vda = persistent ext4.
# /dev/vdb = read-only guest squashfs.
mkdir -p /mnt/persist /mnt/lower /mnt/overlay

# Wait briefly for both virtio block nodes.
for _i in $(seq 1 30); do
    [ -b /dev/vda ] && [ -b /dev/vdb ] && break
    sleep 0.1
done

# Format persistent storage only when mounting and repair both fail.
if ! mount -t ext4 -o rw,noatime,commit=1,barrier=1 /dev/vda /mnt/persist 2>/dev/null; then
    e2fsck -y /dev/vda >/dev/null 2>&1 || mkfs.ext4 -q -F /dev/vda
    mount -t ext4 -o rw,noatime,commit=1,barrier=1 /dev/vda /mnt/persist \
        || { echo "FATAL: persistent ext4 (/dev/vda) mount failed" > /dev/console; ls -l /dev/vd* > /dev/console 2>&1; exec sh; }
fi

# Claim storage.img growth without making boot depend on resize2fs.
resize2fs /dev/vda >/dev/null 2>&1 \
    || echo "WARN: resize2fs /dev/vda failed; storage keeps its previous size" > /dev/console

echo "Mounting system..." > /dev/console
mount -t squashfs -o ro /dev/vdb /mnt/lower \
    || { echo "FATAL: squashfs (/dev/vdb) mount failed" > /dev/console; ls -l /dev/vd* > /dev/console 2>&1; exec sh; }

mkdir -p /mnt/persist/.podroid

# Never overlay an Alpine upper directory onto an Ubuntu lower directory.
# Preserve the old upper instead of deleting it.
NEW_ROOTFS_ID=$(cat /mnt/lower/etc/podroid/rootfs-id 2>/dev/null || echo unknown)
OLD_ROOTFS_ID=$(cat /mnt/persist/.podroid/rootfs-id 2>/dev/null || echo '')
if [ "$NEW_ROOTFS_ID" != "$OLD_ROOTFS_ID" ]; then
    if [ -d /mnt/persist/upper ] && \
       [ -n "$(find /mnt/persist/upper -mindepth 1 -print -quit 2>/dev/null)" ]; then
        _archive_base="/mnt/persist/.podroid/upper-before-${NEW_ROOTFS_ID}"
        _archive="$_archive_base"
        _n=1
        while [ -e "$_archive" ]; do
            _archive="${_archive_base}-${_n}"
            _n=$((_n + 1))
        done
        echo "Preserving previous guest overlay..." > /dev/console
        mv /mnt/persist/upper "$_archive" \
            || { echo "FATAL: could not preserve previous overlay" > /dev/console; exec sh; }
    else
        rm -rf /mnt/persist/upper
    fi

    # work contains overlayfs bookkeeping only. It cannot survive a lower swap.
    rm -rf /mnt/persist/work
    mkdir -p /mnt/persist/upper /mnt/persist/work
    printf '%s\n' "$NEW_ROOTFS_ID" > /mnt/persist/.podroid/rootfs-id.tmp
    mv /mnt/persist/.podroid/rootfs-id.tmp /mnt/persist/.podroid/rootfs-id
else
    mkdir -p /mnt/persist/upper /mnt/persist/work
fi

# Normalize metadata created by older Podroid overlay options once.
if [ ! -f /mnt/persist/.podroid/normalized ]; then
    echo "Normalizing overlay (one-time)..." > /dev/console
    /mnt/lower/usr/local/bin/podroid-overlay-normalize \
        /mnt/persist/upper /mnt/persist/work > /dev/console 2>&1 || true
    : > /mnt/persist/.podroid/normalized
fi

echo "Stacking overlay..." > /dev/console
mount -t overlay overlay \
    -o lowerdir=/mnt/lower,upperdir=/mnt/persist/upper,workdir=/mnt/persist/work \
    /mnt/overlay \
    || { echo "FATAL: overlay mount failed" > /dev/console; ls -l /dev/vd* > /dev/console 2>&1; exec sh; }

# Move persistent storage into the new root.
mkdir -p /mnt/overlay/mnt/persist
mount --move /mnt/persist /mnt/overlay/mnt/persist \
    || { echo "FATAL: mount --move /mnt/persist failed" > /dev/console; exec sh; }

# Keep the immutable lower visible for diagnostics.
mkdir -p /mnt/overlay/mnt/lower
mount --move /mnt/lower /mnt/overlay/mnt/lower \
    || { echo "FATAL: mount --move /mnt/lower failed" > /dev/console; exec sh; }

# Move API filesystems into the real root before starting systemd.
mount --move /proc /mnt/overlay/proc \
    || { echo "FATAL: mount --move /proc failed" > /dev/console; exec sh; }
mount --move /sys /mnt/overlay/sys \
    || { echo "FATAL: mount --move /sys failed" > /dev/console; exec sh; }
mount --move /dev /mnt/overlay/dev \
    || { echo "FATAL: mount --move /dev failed" > /dev/console; exec sh; }
mount --move /run /mnt/overlay/run \
    || { echo "FATAL: mount --move /run failed" > /dev/console; exec sh; }

echo "[podroid-init] switching to Ubuntu root" > /dev/console
exec /sbin/switch_root /mnt/overlay /sbin/init
