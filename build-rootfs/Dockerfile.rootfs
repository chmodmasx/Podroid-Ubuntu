# build-rootfs/Dockerfile.rootfs
#
# Ubuntu 26.04 LTS ARM64 guest rootfs for Podroid.
# The final squashfs keeps the historical alpine-rootfs.squashfs filename.
# Android currently treats that filename as an internal asset ABI.

# ── Stage 1: build Podroid guest helpers for ARM64 ───────────────────────────
FROM --platform=linux/arm64 ubuntu:26.04 AS native-builder
ENV DEBIAN_FRONTEND=noninteractive
RUN sed -i 's/^Components: .*/Components: main universe/' /etc/apt/sources.list.d/ubuntu.sources \
 && apt-get update \
 && apt-get install -y --no-install-recommends \
      build-essential linux-libc-dev ca-certificates \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /work
COPY vsock-agent /work/vsock-agent
RUN cd /work/vsock-agent && make CC=gcc
COPY host-bridge /work/host-bridge
RUN cd /work/host-bridge && make CC=gcc
COPY overlay-normalize /work/overlay-normalize
RUN cd /work/overlay-normalize && make CC=gcc

# ── Stage 2: assemble the Ubuntu ARM64 guest filesystem ─────────────────────
FROM --platform=linux/arm64 ubuntu:26.04 AS rootfs-builder
ARG SYSTEM_VERSION=0
ENV SYSTEM_VERSION=${SYSTEM_VERSION}
ENV UBUNTU_VERSION=26.04
ENV DEBIAN_FRONTEND=noninteractive

# Universe contains several container and desktop packages Podroid needs.
RUN sed -i 's/^Components: .*/Components: main universe/' /etc/apt/sources.list.d/ubuntu.sources \
 && printf '#!/bin/sh\nexit 101\n' > /usr/sbin/policy-rc.d \
 && chmod +x /usr/sbin/policy-rc.d \
 && apt-get update \
 && apt-get install -y --no-install-recommends \
      systemd systemd-sysv dbus \
      bash login passwd adduser sudo \
      podman docker.io docker-compose-v2 \
      lxc lxc-templates \
      crun fuse-overlayfs slirp4netns \
      netavark aardvark-dns \
      iptables nftables bridge-utils iproute2 iputils-ping \
      dropbear openssh-sftp-server \
      curl ca-certificates \
      uidmap libcap2-bin \
      gzip xz-utils \
      tigervnc-standalone-server \
      pulseaudio pulseaudio-utils \
      xfonts-base fonts-dejavu-core \
      procps kmod util-linux e2fsprogs udhcpc hostname fastfetch \
 && rm -f /usr/sbin/policy-rc.d \
 && rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/*

COPY --from=native-builder /work/vsock-agent/podroid-vsock-agent /usr/local/bin/podroid-vsock-agent
COPY --from=native-builder /work/host-bridge/podroid-hostd /usr/local/bin/podroid-hostd
COPY --from=native-builder /work/overlay-normalize/podroid-overlay-normalize /usr/local/bin/podroid-overlay-normalize

COPY files /work/files
COPY build-rootfs.sh /work/build-rootfs.sh
RUN chmod +x /work/build-rootfs.sh \
 && /work/build-rootfs.sh \
 && rm -rf /work/files /work/build-rootfs.sh \
 && rm -rf /tmp/* /var/tmp/*

# ── Stage 3: pack outside the ARM64 stage ───────────────────────────────────
FROM ubuntu:26.04 AS packer
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
 && apt-get install -y --no-install-recommends squashfs-tools \
 && rm -rf /var/lib/apt/lists/*

COPY --from=rootfs-builder / /work/rootfs

# Docker/BuildKit bind-mounts /etc/resolv.conf while a build stage is running,
# so trying to remove it inside rootfs-builder fails with EBUSY. Replace the
# guest copy here, where it is an ordinary file under /work/rootfs.
RUN rm -f /work/rootfs/etc/resolv.conf \
 && printf 'nameserver 8.8.8.8\nnameserver 1.1.1.1\n' > /work/rootfs/etc/resolv.conf \
 && rm -rf /work/rootfs/proc/* /work/rootfs/sys/* /work/rootfs/dev/* \
           /work/rootfs/run/* /work/rootfs/tmp/* /work/rootfs/var/tmp/* \
 && mkdir -p /work/rootfs/proc /work/rootfs/sys /work/rootfs/dev \
             /work/rootfs/run /work/rootfs/tmp /work/rootfs/var/tmp \
 && chmod 1777 /work/rootfs/tmp /work/rootfs/var/tmp \
 && test -x /work/rootfs/usr/lib/systemd/systemd \
 && test -x /work/rootfs/usr/local/bin/podroid-vsock-agent \
 && test -x /work/rootfs/usr/local/bin/podroid-hostd \
 && test -x /work/rootfs/usr/local/bin/podroid-overlay-normalize \
 && grep -q '^ID=ubuntu$' /work/rootfs/etc/os-release \
 && grep -q '^ubuntu-26.04$' /work/rootfs/etc/podroid/rootfs-id

# Keep the legacy asset filename until the Android asset ABI is renamed.
RUN mksquashfs /work/rootfs /work/alpine-rootfs.squashfs \
    -comp zstd -Xcompression-level 19 -all-root -noappend
# Do not use -no-xattrs. newuidmap/newgidmap capabilities must survive.

FROM scratch AS export
COPY --from=packer /work/alpine-rootfs.squashfs /alpine-rootfs.squashfs
